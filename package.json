{
  "name": "@zubenelakrab/musiclab",
  "version": "2.0.2",
  "description": "Web-based music production environment with live coding and visual sequencers, built on Strudel",
  "private": false,
  "type": "module",
  "keywords": [
    "music",
    "audio",
    "live-coding",
    "strudel",
    "tidalcycles",
    "sequencer",
    "drum-machine",
    "synthesizer",
    "daw",
    "web-audio",
    "music-production",
    "beat-maker"
  ],
  "author": "zubenelakrab",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zubenelakrab/musiclab.git"
  },
  "bugs": {
    "url": "https://github.com/zubenelakrab/musiclab/issues"
  },
  "homepage": "https://github.com/zubenelakrab/musiclab#readme",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node server/index.js",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client",
    "preview": "npm run preview --workspace=client",
    "test": "node --test tests/*.test.js",
    "lint": "eslint .",
    "verify": "npm run lint && npm run test && npm run build"
  },
  "workspaces": [
    "client"
  ],
  "devDependencies": {
    "concurrently": "^8.2.2",
    "eslint": "^10.1.0",
    "globals": "^17.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
